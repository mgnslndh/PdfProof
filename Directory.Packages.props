<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!-- A version listed here also applies when a package comes in transitively, so a vulnerable transitive
         dependency is fixed in one place. -->
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <ItemGroup>
    <!-- A PdfPig upgrade can change extraction and every consumer's snapshots: upgrade deliberately (spec §15). -->
    <PackageVersion Include="PdfPig" Version="0.1.16" />
    <PackageVersion Include="Polyfill" Version="11.4.3" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.12" />
    <PackageVersion Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" Version="5.6.0" />
    <!-- xunit.v3 3.2.x: what Verify.XunitV3 32.0.1 (the last MIT Verify) is built against; used from Plan 2 on. -->
    <PackageVersion Include="xunit.v3" Version="3.2.2" />
    <!-- The build under build/. Cake.Common matches Cake.Sdk in global.json. -->
    <PackageVersion Include="Cake.Common" Version="6.3.0" />
    <PackageVersion Include="Cake.BuildSystems.Module" Version="9.0.0" />
    <!-- Version from the latest git tag (v-prefixed); untagged builds get 0.0.0-alpha.0.<height>. -->
    <PackageVersion Include="MinVer" Version="8.0.0" />
    <!-- Tests only: encrypts test PDFs in memory (PdfPig reads encrypted PDFs but can't write them). -->
    <PackageVersion Include="PDFsharp" Version="6.2.4" />
    <!-- Transitive only: PDFsharp, PDFsharp-MigraDoc and Cake bring 8.0.1 or 10.0.12, which have known vulnerabilities
         (GHSA-2fmv-rv2c-59x7, GHSA-846f-f764-76mx). Pinned through transitive pinning above. -->
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
    <!-- Corpus tests on .NET Framework read the oracle with it; net10.0 has it in the box. -->
    <PackageVersion Include="System.Text.Json" Version="10.0.12" />
    <!-- The fixture generator's producers (tools/, never shipped). Pinned: a new version changes the fixtures. -->
    <PackageVersion Include="Select.HtmlToPdf.NetCore" Version="26.4.0" />
    <!-- Playwright pins the Chromium build it installs. -->
    <PackageVersion Include="Microsoft.Playwright" Version="1.63.0" />
    <PackageVersion Include="QuestPDF" Version="2026.9.1" />
    <PackageVersion Include="PDFsharp-MigraDoc" Version="6.2.4" />
  </ItemGroup>
</Project>
